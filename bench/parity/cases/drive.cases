case drive/setup
drive setup --setup

case drive/setup with a binding
tofu models bind orchestrator claude-sub/claude-opus-5
drive setup --setup

case drive/welcome fresh
drive welcome --fresh

case drive/welcome
drive welcome

case drive/continue after a run
tofu models bind orchestrator claude-sub/claude-opus-5
TOFU_DRIVE_CASSETTE=$DATA/serve/tools.jsonl tofu run --no-gate --dir $PROJECT "read the note and write one"
drive tab-subagents-command --continue

case drive/source claude-sub
drive chat --cassette $DATA/serve/tools.jsonl --source claude-sub

case drive/source codex-sub
drive chat --cassette $DATA/serve/tools.jsonl --source codex-sub

case drive/arm no-subagents
drive chat --cassette $DATA/serve/tools.jsonl --no-subagents

case drive/arm tools three
drive chat --cassette $DATA/serve/tools.jsonl --tools three

case drive/arm no-instructions
write AGENTS.md always answer in a mock voice\n
drive chat --cassette $DATA/serve/tools.jsonl --no-instructions

case drive/agents file read
write AGENTS.md always answer in a mock voice\n
drive chat --cassette $DATA/serve/tools.jsonl

case drive/flow 1-two-report
drive 1-two-report

case drive/flow 10-steer-image
drive 10-steer-image --host --clipboard $DATA/drive/10-shot.png

case drive/flow 11-fork-roster
drive 11-fork-roster
