-- check/zz_check_test.go --
package task

import (
	"path/filepath"
	"testing"
)

func TestCheckResentRequests(t *testing.T) {
	path := filepath.Join(t.TempDir(), "ledger.txt")
	if b, err := Balance(path); err != nil || b != 0 {
		t.Fatalf("empty Balance = %d, %v", b, err)
	}
	for _, c := range []struct {
		id    string
		cents int
	}{{"r1", 100}, {"r1", 100}, {"r2", 50}, {"r1", 100}, {"r3", 7}, {"r2", 50}} {
		if err := Credit(path, c.id, c.cents); err != nil {
			t.Fatal(err)
		}
	}
	if b, err := Balance(path); err != nil || b != 157 {
		t.Fatalf("Balance = %d, %v, want 157", b, err)
	}
}
