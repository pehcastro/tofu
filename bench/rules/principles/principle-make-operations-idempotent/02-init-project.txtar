Implement Init in init.go. Init prepares dir for the application: it makes dir and dir/data, and writes dir/config.json holding the default configuration {"port": 8080, "name": "app"}. Users edit config.json by hand after installing. Init is called by the installer, the installer can be killed at any moment, and users run the installer again whenever something went wrong.
-- go.mod --
module task

go 1.25
-- init.go --
package task

func Init(dir string) error {
	return nil
}
-- check/zz_check_test.go --
package task

import (
	"encoding/json"
	"os"
	"path/filepath"
	"testing"
)

func checkConfig(t *testing.T, dir string) map[string]any {
	t.Helper()
	data, err := os.ReadFile(filepath.Join(dir, "config.json"))
	if err != nil {
		t.Fatal(err)
	}
	var c map[string]any
	if err := json.Unmarshal(data, &c); err != nil {
		t.Fatalf("config.json does not parse: %v: %q", err, data)
	}
	return c
}

func TestCheckFreshAndRepeated(t *testing.T) {
	dir := filepath.Join(t.TempDir(), "app")
	for i := 0; i < 3; i++ {
		if err := Init(dir); err != nil {
			t.Fatalf("Init call %d: %v", i+1, err)
		}
	}
	if st, err := os.Stat(filepath.Join(dir, "data")); err != nil || !st.IsDir() {
		t.Error("data is not a directory")
	}
	if c := checkConfig(t, dir); c["port"] != 8080.0 || c["name"] != "app" {
		t.Errorf("config = %v", c)
	}
}

func TestCheckKeepsUserEdit(t *testing.T) {
	dir := t.TempDir()
	if err := Init(dir); err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(filepath.Join(dir, "config.json"), []byte(`{"port": 9000, "name": "mine"}`), 0o644); err != nil {
		t.Fatal(err)
	}
	if err := Init(dir); err != nil {
		t.Fatal(err)
	}
	if c := checkConfig(t, dir); c["port"] != 9000.0 || c["name"] != "mine" {
		t.Errorf("user edit lost: %v", c)
	}
}

func TestCheckRecoversFromKilledWrite(t *testing.T) {
	dir := t.TempDir()
	if err := os.WriteFile(filepath.Join(dir, "config.json"), nil, 0o644); err != nil {
		t.Fatal(err)
	}
	if err := Init(dir); err != nil {
		t.Fatal(err)
	}
	if c := checkConfig(t, dir); c["port"] != 8080.0 {
		t.Errorf("an empty config.json left by a killed installer was kept: %v", c)
	}
}
