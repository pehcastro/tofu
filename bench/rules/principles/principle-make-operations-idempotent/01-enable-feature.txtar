	return nil
}
-- check/zz_check_test.go --
package task

import (
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func checkLines(t *testing.T, path string) []string {
	t.Helper()
	data, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	return strings.Fields(string(data))
}

func TestCheckRepeatedCalls(t *testing.T) {
	path := filepath.Join(t.TempDir(), "app.conf")
	for i := 0; i < 3; i++ {
		if err := EnableFeature(path, "search"); err != nil {
			t.Fatal(err)
		}
	}
	if got := checkLines(t, path); len(got) != 1 || got[0] != "feature.search=on" {
		t.Errorf("after three calls: %q", got)
	}
}

func TestCheckExistingFile(t *testing.T) {
	path := filepath.Join(t.TempDir(), "app.conf")
	if err := os.WriteFile(path, []byte("port=80\nfeature.search=off\nname=x\n"), 0o644); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < 2; i++ {
		if err := EnableFeature(path, "search"); err != nil {
			t.Fatal(err)
		}
		if err := EnableFeature(path, "beta"); err != nil {
			t.Fatal(err)
		}
	}
	got := checkLines(t, path)
	count := map[string]int{}
	for _, l := range got {
		count[l]++
	}
	if len(got) != 4 || count["port=80"] != 1 || count["name=x"] != 1 || count["feature.search=on"] != 1 || count["feature.beta=on"] != 1 {
		t.Errorf("file is %q", got)
	}
}
