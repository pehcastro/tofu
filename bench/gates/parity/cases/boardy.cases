tofu boardy rule add parity-nudge --when after --on ticket.move --then nudge --text "a mock nudge"
tofu boardy rule list
tofu boardy rule show parity-nudge
tofu boardy rule test parity-nudge PAR-1 --to doing
tofu boardy move PAR-1 doing --reason r
tofu boardy rule remove parity-nudge

case boardy/manager flow
tofu boardy init --key PAR --mode empty
tofu boardy new --board PAR --type task --priority P2 --owns src/** --problem "a mock problem" --scope "a mock scope" --before "nothing ran" --driven "tofu version prints it" --still-works "tofu docs still prints" --error-case "a bad flag exits 2" --acceptance "tofu version prints the version" "parity mock ticket"
tofu boardy manager add parity
tofu boardy manager list
tofu boardy manager remove parity
tofu boardy manager list

case boardy/ask then catchup
tofu boardy init --key PAR --mode empty
tofu boardy new --board PAR --type task --priority P2 --owns src/** --problem "a mock problem" --scope "a mock scope" --before "nothing ran" --driven "tofu version prints it" --still-works "tofu docs still prints" --error-case "a bad flag exits 2" --acceptance "tofu version prints the version" "parity mock ticket"
tofu boardy ask PAR-1 --tldr t --eli5 e --options "one | two" --recommend 1 --why w
tofu boardy catchup
tofu boardy attention

case boardy/no board
tofu boardy list
tofu boardy show PAR-1
tofu boardy boards --json
