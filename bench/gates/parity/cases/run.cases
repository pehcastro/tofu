case run/no binding
TOFU_DRIVE_CASSETTE=$DATA/serve/tools.jsonl tofu run --no-gate --dir $PROJECT "read the note and write one"

case run/gate enforce without a classifier
tofu models bind orchestrator claude-sub/claude-opus-5
TOFU_DRIVE_CASSETTE=$DATA/serve/tools.jsonl tofu run --dir $PROJECT "read the note and write one"

case run/no dir
tofu models bind orchestrator claude-sub/claude-opus-5
tofu run "read the note"

case run/no task
tofu models bind orchestrator claude-sub/claude-opus-5
tofu run --dir $PROJECT

case run/no cassette
tofu models bind orchestrator claude-sub/claude-opus-5
tofu run --no-gate --dir $PROJECT "read the note"

case run/second turn of the session
tofu models bind orchestrator claude-sub/claude-opus-5
TOFU_DRIVE_CASSETTE=$DATA/serve/tools.jsonl tofu run --no-gate --dir $PROJECT "read the note and write one"
TOFU_DRIVE_CASSETTE=$DATA/serve/hello.jsonl tofu run --no-gate --session head --dir $PROJECT "say hello"
tofu session list

case run/sub-agents
tofu models bind orchestrator claude-sub/claude-opus-5
TOFU_DRIVE_CASSETTE=$DATA/serve/spawn.jsonl tofu run --no-gate --dir $PROJECT "run two workers"
tofu session info head

case run/unknown flag
tofu models bind orchestrator claude-sub/claude-opus-5
tofu run --parity-bogus --dir $PROJECT "x"

case run/AGENTS.md read
tofu models bind orchestrator claude-sub/claude-opus-5
write AGENTS.md always answer in a mock voice\n
TOFU_DRIVE_CASSETTE=$DATA/serve/hello.jsonl tofu run --no-gate --show-prompt --dir $PROJECT "say hello"
