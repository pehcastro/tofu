{
  "manifest_version": 3,
  "name": "tofu",
  "version": "0.4.0",
  "description": "Lets tofu read and drive your Chrome tabs, group the tabs it works in, and open and close inactive tabs of its own.",
  "key": "",
  "permissions": ["nativeMessaging", "debugger", "tabs", "tabGroups", "storage"],
  "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"},
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "tofu", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}
}
