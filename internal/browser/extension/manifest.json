{
  "manifest_version": 3,
  "name": "tofu",
  "version": "0.3.0",
  "description": "Lets tofu read and drive a tab you share with it, and open and close inactive tabs of its own.",
  "key": "",
  "permissions": ["nativeMessaging", "debugger", "tabs", "activeTab"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "tofu", "default_popup": "popup.html"}
}
