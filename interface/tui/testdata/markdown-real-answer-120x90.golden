    [38;2;103;228;128;1mWhat it[m[48;2;25;22;34m[38;2;103;228;128;1m is[m[48;2;25;22;34m                                                                                                          
                                                                                                                        
    [38;2;116;173;232mtofu[m[48;2;25;22;34m[38;2;225;225;230m (named Boji in the docs) is a personal Go coding-agent harness. One static binary, no cgo, no daemon. The[m[48;2;25;22;34m      
    [38;2;225;225;230mstance: [m[48;2;25;22;34m[38;2;225;225;230;1mcode owns the loop, a language model plans and writes, and a small typed decision model called Jev[m[48;2;25;22;34m          
    [1;38;2;225;225;230mclassifies state wherever other harnesses use a prose rule, a regex, or a frontier-model guess.[m[48;2;25;22;34m[38;2;225;225;230m Not released,[m[48;2;25;22;34m       
    [38;2;225;225;230mnot sold, local-only git on [m[48;2;25;22;34m[38;2;116;173;232mdevelop[m[48;2;25;22;34m[38;2;225;225;230m.[m[48;2;25;22;34m                                                                                
                                                                                                                        
    [38;2;225;225;230m[m[48;2;25;22;34m[38;2;103;228;128;1mHow it hangs[m[48;2;25;22;34m[38;2;103;228;128;1m together[m[48;2;25;22;34m                                                                                               
                                                                                                                        
    [38;2;225;225;230mFive roots, dependency order[m[48;2;25;22;34m[38;2;225;225;230m bottom-up:[m[48;2;25;22;34m                                                                             
                                                                                                                        
    [38;2;225;225;230m• [m[48;2;25;22;34m[38;2;116;173;232mlibrary/[m[48;2;25;22;34m[38;2;225;225;230m: everything shipped as data, no code, bottom of the import graph. Models, subscriptions, roles,[m[48;2;25;22;34m          
    [38;2;225;225;230mquestion sets, policies (thresholds), house rules. Resolved in three layers, field by field: embedded, then [m[48;2;25;22;34m[38;2;116;173;232m~/.[m[48;2;25;22;34m     
    [38;2;116;173;232mboji/[m[48;2;25;22;34m[38;2;225;225;230m, then [m[48;2;25;22;34m[38;2;116;173;232m./.boji/[m[48;2;25;22;34m[38;2;225;225;230m, last mention wins. Refusals are named by file and field, never[m[48;2;25;22;34m[38;2;225;225;230m skipped.[m[48;2;25;22;34m                       
    [38;2;225;225;230m• [m[48;2;25;22;34m[38;2;116;173;232minternal/[m[48;2;25;22;34m[38;2;225;225;230m: 19 packages. [m[48;2;25;22;34m[38;2;116;173;232mjudge/[m[48;2;25;22;34m[38;2;225;225;230m (jev client, question, policy, ledger, state) is the instrument; [m[48;2;25;22;34m[38;2;116;173;232mturn/[m[48;2;25;22;34m[38;2;225;225;230m is the[m[48;2;25;22;34m      
    [38;2;225;225;230magent loop with its tool set ([m[48;2;25;22;34m[38;2;116;173;232mglob[m[48;2;25;22;34m[38;2;225;225;230m, [m[48;2;25;22;34m[38;2;116;173;232mgrep[m[48;2;25;22;34m[38;2;225;225;230m, [m[48;2;25;22;34m[38;2;116;173;232msearch[m[48;2;25;22;34m[38;2;225;225;230m, [m[48;2;25;22;34m[38;2;116;173;232msymbols[m[48;2;25;22;34m[38;2;225;225;230m, [m[48;2;25;22;34m[38;2;116;173;232mread[m[48;2;25;22;34m[38;2;225;225;230m, [m[48;2;25;22;34m[38;2;116;173;232medit[m[48;2;25;22;34m[38;2;225;225;230m, [m[48;2;25;22;34m[38;2;116;173;232mbash[m[48;2;25;22;34m[38;2;225;225;230m, [m[48;2;25;22;34m[38;2;116;173;232mweb[m[48;2;25;22;34m[38;2;225;225;230m, [m[48;2;25;22;34m[38;2;116;173;232mgithub[m[48;2;25;22;34m[38;2;225;225;230m, [m[48;2;25;22;34m[38;2;116;173;232mplan[m[48;2;25;22;34m[38;2;225;225;230m, [m[48;2;25;22;34m[38;2;116;173;232mmemo[m[48;2;25;22;34m[38;2;225;225;230m); [m[48;2;25;22;34m[38;2;116;173;232msession/[m[48;2;25;22;34m     
