        "description": "tofu uses Zed Nu Disco; choose a palette"
      },
      {
        "key": "density",
        "category": "Appearance",
        "default": "comfortable",
        "takes": "one of compact, comfortable, spacious",
        "restart": false,
        "description": "Spacing across lists and panels"
      },
