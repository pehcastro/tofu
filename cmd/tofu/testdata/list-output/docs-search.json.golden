exit 0
--- stdout
{
  "tofu": "VERSION",
  "verb": "docs",
  "ok": true,
  "at": "AT",
  "data": {
    "query": "change the colours",
    "matches": [
      {
        "text": "change the colours",
        "do": "tofu settings set theme Nord"
      },
      {
        "text": "change when a scheduled job fires",
        "do": "/cron edit c1 --schedule \"every 30m\" --reason \"the build is stable\""
      },
      {
        "text": "Sub-agents",
        "do": "tofu docs agents"
      },
      {
        "text": "Browser",
        "do": "tofu docs browser"
      },
      {
        "text": "Commands in the app",
        "do": "tofu docs commands"
      },
      {
        "text": "Cron, loops and goals",
        "do": "tofu docs cron"
      },
      {
        "text": "The doctor",
        "do": "tofu docs doctor"
      },
      {
        "text": "Driving the app from a script",
        "do": "tofu docs drive"
      },
      {
        "text": "The gate",
        "do": "tofu docs gate"
      },
      {
        "text": "Hooks",
        "do": "tofu docs hooks"
      },
      {
        "text": "Keys",
        "do": "tofu docs keys"
      },
      {
        "text": "Memory",
        "do": "tofu docs memory"
      },
      {
        "text": "Models",
        "do": "tofu docs models"
      },
      {
        "text": "Every method tofu serve answers",
        "do": "tofu docs serve-methods"
      },
      {
        "text": "Serving a project to another program",
        "do": "tofu docs serve"
      },
      {
        "text": "Shells and long commands",
        "do": "tofu docs shells"
      },
      {
        "text": "Start here",
        "do": "tofu docs start"
      },
      {
        "text": "Program status on the terminal",
        "do": "tofu docs status"
      },
      {
        "text": "Updating tofu",
        "do": "tofu docs update"
      },
      {
        "text": "stop the animations",
        "do": "tofu settings set animations off"
      },
      {
        "text": "show every tool call in the chat",
        "do": "tofu settings set chatShowsTools true"
      },
      {
        "text": "hide the model's thinking",
        "do": "tofu settings set showThinking false"
      },
      {
        "text": "pick the model a sub-agent tier runs",
        "do": "tofu settings set modelTier.smart claude-sub/claude-sonnet-5"
      },
      {
        "text": "change a setting for one project only",
        "do": "tofu settings set --scope project <key> <value>"
      },
      {
        "text": "move old sessions out of the project",
        "do": "tofu migrate"
      },
      {
        "text": "update tofu to the latest release",
        "do": "tofu update"
      },
      {
        "text": "change what a rule tofu ships says, for this project",
        "do": "tofu rules add <id> \"<text>\" --reason \"<why>\""
      },
      {
        "text": "run the next task on another model",
        "do": "/models in the app, then pick a model"
      },
      {
        "text": "always run the orchestrator on one model",
        "do": "write model: <source/model> in ~/.tofu/roles/orchestrator.yaml"
      },
      {
        "text": "see which skills the model is offered",
        "do": "tofu run --dir . --show-prompt \"anything\""
      },
      {
        "text": "store the openrouter key the gate needs",
        "do": "tofu login classifier openrouter"
      },
      {
        "text": "work one task with the gate off",
        "do": "tofu run --dir . --no-gate \"<task>\""
      },
      {
        "text": "see how full the context window got",
        "do": "tofu context"
      },
      {
        "text": "free room in the context before the next turn",
        "do": "/compact in the app, between turns"
      },
      {
        "text": "undo what the last turn changed",
        "do": "tofu undo, or /undo in the app"
      },
      {
        "text": "read the output of a running shell",
        "do": "tofu shells log <name>"
      },
      {
        "text": "see the Claude Code and codex hooks tofu runs here",
        "do": "tofu hooks"
      },
      {
        "text": "check the library files and these pages",
        "do": "tofu library"
      },
      {
        "text": "let the model read the Chrome tabs tofu can reach",
        "do": "tofu settings set browser read"
      },
      {
        "text": "let the model click and type in the tabs tofu can reach",
        "do": "tofu settings set browser drive"
      },
      {
        "text": "take the browser tools away from the model",
        "do": "tofu settings set browser off"
      },
      {
        "text": "let jev pick each browser step toward a whole goal instead of the model",
        "do": "tofu settings set browserDriver goal"
      },
      {
        "text": "repeat a prompt every few minutes",
        "do": "/loop 10m check the build"
      },
      {
        "text": "keep working until a test passes",
        "do": "/goal make the test pass --until \"go test ./...\""
      },
      {
        "text": "find a prompt I sent in another session",
        "do": "ctrl+p in the app, type part of it, then enter"
      },
      {
        "text": "Files tofu reads and writes",
        "do": "tofu docs files"
      },
      {
        "text": "Instruction files",
        "do": "tofu docs instructions"
      },
      {
        "text": "Learn",
        "do": "tofu docs learn"
      },
      {
        "text": "Rules",
        "do": "tofu docs rules"
      },
      {
        "text": "Sessions",
        "do": "tofu docs sessions"
      },
      {
        "text": "Settings",
        "do": "tofu docs settings"
      },
      {
        "text": "Skills",
        "do": "tofu docs skills"
      }
    ]
  },
  "problems": []
}
