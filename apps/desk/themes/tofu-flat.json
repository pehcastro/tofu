{
  "name": "Tofu Flat",
  "extends": "tofu-glass",
  "mode": "dark",
  "cards": {
    "outer": { "gap": 0 },
    "inner": { "highlight": false }
  },
  "shape": { "blur": 0 },
  "dark": {
    "surface": { "window": "#17161cff" },
    "cards": {
      "outer": { "fill": "#18171eeb", "border": "none" },
      "inner": { "fill": "#00000000", "fill_end": "#00000000", "border": "none" }
    },
    "toast": { "fill": "#24232a", "border": "none" },
    "tabs": { "fill": "#ffffff0f" }
  },
  "light": {
    "surface": { "window": "#f4f3f6ff" },
    "cards": {
      "outer": { "fill": "#ecebf0ff", "border": "none" },
      "inner": { "fill": "#00000000", "fill_end": "#00000000", "border": "none" }
    },
    "toast": { "fill": "#ffffff", "border": "none" },
    "tabs": { "fill": "#17161c0f" }
  }
}
