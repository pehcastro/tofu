{
  "name": "Tofu Flat",
  "extends": "tofu-glass",
  "mode": "dark",
  "cards": {
    "outer": { "gap": 0 },
    "inner": { "highlight": false }
  },
  "shape": { "blur": 0 },
  "dark": {
    "surface": { "window": "#17161cff" },
    "cards": {
      "outer": { "fill": "#18171eeb", "border": "none" },
