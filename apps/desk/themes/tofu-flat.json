    "toast": { "fill": "#ffffff", "border": "none" },
    "tabs": { "fill": "#17161c0f" },
    "intro": {
      "composer_fill": "#18171eff",
      "composer_border": "#ffffff29",
      "placeholder": "#ffffff61",
      "icon": "#ffffff73",
      "model_text": "#ffffffd9",
