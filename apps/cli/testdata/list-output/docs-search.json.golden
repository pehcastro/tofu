        "text": "Learn",
        "do": "tofu docs learn"
      },
      {
        "text": "Rules",
        "do": "tofu docs rules"
      },
      {
        "text": "Sessions",
        "do": "tofu docs sessions"
      },
      {
        "text": "Skills",
        "do": "tofu docs skills"
      },
      {
        "text": "Walls: how long each operation took",
        "do": "tofu docs walls"
      }
