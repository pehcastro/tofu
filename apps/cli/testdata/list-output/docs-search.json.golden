        "do": "tofu docs status"
      },
      {
        "text": "One tool call by hand",
        "do": "tofu docs tool"
      },
      {
        "text": "The tools that change code",
        "do": "tofu docs tools-change"
      },
      {
        "text": "Checks, files and shell tools",
        "do": "tofu docs tools-checks"
      },
      {
        "text": "Code intelligence tools",
        "do": "tofu docs tools-code"
      },
      {
        "text": "Tools for the agent's own context and its own work",
        "do": "tofu docs tools-context"
      },
      {
        "text": "The debug tool",
        "do": "tofu docs tools-debug"
      },
      {
        "text": "Work, web, environment and delegation tools",
        "do": "tofu docs tools-work"
      },
      {
        "text": "What the tools return",
        "do": "tofu docs tools"
      },
      {
        "text": "History and undo",
        "do": "tofu docs turn-history"
      },
      {
        "text": "Updating tofu",
        "do": "tofu docs update"
      },
      {
        "text": "Subscription quota",
        "do": "tofu docs usage"
      },
      {
        "text": "stop the animations",
        "do": "tofu settings set animations off"
      },
      {
        "text": "show every tool call in the chat",
        "do": "tofu settings set chatShowsTools true"
      },
      {
        "text": "hide the model's thinking",
        "do": "tofu settings set showThinking false"
      },
      {
        "text": "pick the model a sub-agent tier runs",
        "do": "tofu settings set modelTier.smart claude-sub/claude-sonnet-5"
      },
      {
        "text": "change a setting for one project only",
        "do": "tofu settings set --scope project <key> <value>"
      },
      {
        "text": "move old sessions out of the project",
        "do": "tofu migrate"
      },
      {
        "text": "update tofu to the latest release",
        "do": "tofu update"
      },
      {
        "text": "change what a rule tofu ships says, for this project",
        "do": "tofu rules add <id> \"<text>\" --reason \"<why>\""
      },
      {
        "text": "run the next task on another model",
        "do": "/models in the app, then pick a model"
      },
      {
        "text": "always run the orchestrator on one model",
        "do": "tofu models bind orchestrator claude-sub/claude-sonnet-5"
      },
      {
        "text": "pick the model every sub-agent runs",
        "do": "tofu models bind sub-agent claude-sub/claude-sonnet-5"
      },
      {
        "text": "why the quota reading is stale or how old it is",
        "do": "tofu usage"
      },
      {
        "text": "see which skills the model is offered",
        "do": "tofu run --dir . --show-prompt \"anything\""
      },
      {
        "text": "write a map of my project's folders",
        "do": "/generate-map in the app, then answer yes to write MAP.md"
      },
      {
        "text": "store the typesafe key the gate needs",
        "do": "tofu login classifier typesafe"
      },
      {
        "text": "bind the classifier the gate runs",
        "do": "tofu models bind classifier typesafe/jev-latest"
      },
      {
        "text": "work one task with the gate off",
        "do": "tofu run --dir . --no-gate \"<task>\""
      },
      {
        "text": "see how full the context window got",
        "do": "tofu context"
      },
      {
        "text": "free room in the context before the next turn",
        "do": "/compact in the app, between turns"
      },
      {
        "text": "undo what the last turn changed",
        "do": "tofu undo, or /undo in the app"
      },
      {
        "text": "read the output of a running shell",
        "do": "tofu shells log <name>"
      },
      {
        "text": "see what agents left in the scratchpad",
        "do": "tofu scratch"
      },
      {
        "text": "clean the scratchpad",
        "do": "tofu scratch clean"
      },
      {
        "text": "see what other sessions asked the board for",
        "do": "tofu boardy triage list"
      },
      {
        "text": "sum up the board",
        "do": "tofu boardy report --since 7d"
      },
      {
        "text": "see the Claude Code and codex hooks tofu runs here",
        "do": "tofu hooks"
      },
      {
        "text": "check the library files and these pages",
        "do": "tofu library"
      },
      {
        "text": "let the model read the Chrome tabs tofu can reach",
        "do": "tofu settings set browser read"
      },
      {
        "text": "let the model click and type in the tabs tofu can reach",
        "do": "tofu settings set browser drive"
      },
      {
        "text": "take the browser tools away from the model",
        "do": "tofu settings set browser off"
      },
      {
        "text": "let jev pick each browser step toward a whole goal instead of the model",
        "do": "tofu settings set browserDriver goal"
      },
      {
        "text": "repeat a prompt every few minutes",
        "do": "/loop 10m check the build"
      },
      {
        "text": "keep working until a test passes",
        "do": "/goal make the test pass --until \"go test ./...\""
      },
      {
        "text": "find a prompt I sent in another session",
        "do": "ctrl+p in the app, type part of it, then enter"
      },
      {
        "text": "check a commit message the way the git hook does",
        "do": "tofu guard git commit-msg .git/COMMIT_EDITMSG"
      },
      {
        "text": "run one tool call by hand and see what the model would read",
        "do": "tofu tool read '{\"path\":\"README.md\"}' --dir ."
      },
      {
        "text": "run the tests of one package and see only what failed",
        "do": "tofu tool test '{\"path\":\".\"}' --dir ."
      },
      {
        "text": "check a report against the calls the session made",
        "do": "tofu tool claims '{\"report\":\"All tests pass.\"}' --dir . --session head"
      },
      {
        "text": "which turn made this change, and put it back",
        "do": "tofu tool trail '{\"mode\":\"find\",\"anchor\":\"handling fee\"}' --dir ."
      },
      {
        "text": "which turn broke the tests",
        "do": "tofu tool bisect '{\"check\":\"test\",\"name\":\"TestTotal\"}' --dir ."
      },
      {
        "text": "see the values on one call of a function without print lines",
        "do": "tofu tool debug '{\"steps\":[\"start test TestTill\",\"break till.go:14 --if t.rung == 3\",\"run\",\"eval cents\",\"stop\"]}' --dir ."
      },
      {
        "text": "rewrite one code shape everywhere without touching strings",
        "do": "tofu tool codemod '{\"lang\":\"go\",\"pattern\":\"t.Fatalf($$$ARGS)\",\"rewrite\":\"t.Errorf($$$ARGS)\"}' --dir ."
      },
      {
        "text": "make a new file shaped like an existing one",
        "do": "tofu tool scaffold '{\"kind\":\"type\",\"name\":\"Invoice\",\"like\":\"order.go\"}' --dir ."
      },
      {
        "text": "add a dependency after checking its license and advisories",
        "do": "tofu tool deps '{\"mode\":\"add\",\"package\":\"github.com/google/uuid\"}' --dir ."
      },
      {
        "text": "which dependencies have a newer release",
        "do": "tofu tool deps '{\"mode\":\"outdated\"}' --dir ."
      },
      {
        "text": "which tools does the review agent get",
        "do": "tofu tool list --agent review"
      },
      {
        "text": "read the lines around one function",
        "do": "tofu tool read '{\"path\":\"order.go\",\"at\":\"Total\"}' --dir ."
      },
      {
        "text": "what else must change if I change this type",
        "do": "tofu tool symbols '{\"name\":\"Order\",\"mode\":\"impact\"}' --dir ."
      },
      {
        "text": "what does this dependency look like at the version we pinned",
        "do": "tofu tool api '{\"package\":\"github.com/pelletier/go-toml/v2\",\"name\":\"NewDecoder\"}' --dir ."
      },
      {
        "text": "see what is in the project database without writing to it",
        "do": "tofu tool db '{\"env\":\"DATABASE_URL\"}' --dir ."
      },
      {
        "text": "try two approaches at once and keep the one that passes",
        "do": "tofu docs tools"
      },
      {
        "text": "tell me something during a turn without stopping it",
        "do": "tofu tool heads_up '{\"level\":\"info\",\"line\":\"the full test run takes about two minutes\"}' --dir ."
      },
      {
        "text": "what does the model see filling its own window",
        "do": "tofu tool context '{}' --dir . --session head"
      },
      {
        "text": "let the model ask a cheap model about one long result",
        "do": "tofu settings set modelTier.dumb <source/model>"
      },
      {
        "text": "Files tofu reads and writes",
        "do": "tofu docs files"
      },
      {
        "text": "Instruction files",
        "do": "tofu docs instructions"
      },
